# Frontend env — Vite reads `VITE_*`
# FastAPI backend base URL (see backend_py/app/main.py and backend_py/Makefile PORT=8000)
VITE_API_URL=http://localhost:8000

# Alternative if running legacy NestJS on :3000:
# VITE_API_URL=http://localhost:3000
# Or set DATABASE_URL=sqlite:///./finance_app.db in backend_py to run without MySQL

# Pull spec and generate typed client:
#   npm run gen:api        # live: http://localhost:8000/openapi.json -> src/api/generated (fetch client, no axios)
#   npm run gen:api:local  # offline: ./openapi.json -> src/api/generated
#   npm run gen:api:pull   # curl -> ./openapi.json then generate (works with :8000 or :3000)
